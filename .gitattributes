# Normalize line endings: LF in the repo, so Linux CI (GitHub Actions) and Windows agree
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must keep LF (gradlew breaks with CRLF on CI)
gradlew text eol=lf
*.sh    text eol=lf

# Binary files: never touch
*.jar  binary
*.png  binary
*.jpg  binary
*.webp binary
*.pdf  binary
*.ttf  binary
*.otf  binary
